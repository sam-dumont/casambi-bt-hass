         if not self._httpClient:
             self._httpClient = AsyncClient()

+        # Use api_address for API lookups if provided, otherwise use addr
+        # This is useful on macOS where BLEDevice.address is a UUID, not a MAC address
+        api_addr = api_address if api_address else addr
+        if api_address:
+            self._logger.info(f"Using API address {api_address} for cloud lookups (BLE address: {addr})")
+
         # Retrieve network information
-        uuid = addr.replace(":", "").lower()
+        uuid = api_addr.replace(":", "").lower()
